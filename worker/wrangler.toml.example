name = "prvt"
main = "src/index.js"
compatibility_date = "2024-09-23"

routes = [{ pattern = "your.domain/*", zone_name = "your.domain" }]

[[kv_namespaces]]
binding = "LINKS"
id = "<links-namespace-id>"

[[kv_namespaces]]
binding = "COOLOFF"
id = "<cooloff-namespace-id>"

[[unsafe.bindings]]
name = "SHORTEN_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 10, period = 60 }

# Secrets — set via: wrangler secret put ADMIN_SECRET
# and: wrangler secret put FORM_TOKEN
# For local dev, create worker/.dev.vars with ADMIN_SECRET= and FORM_TOKEN=
